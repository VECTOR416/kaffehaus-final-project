# Plantilla de variables de entorno de KaffeHaus v4.
# Copiala como .env en esta carpeta y completa los valores. El .env no se versiona.
# La leen la aplicacion (application.yaml), docker compose y la configuracion de VS Code.
# Formato: KEY=valor, sin comillas ni espacios alrededor del '='.
# Las variables marcadas como obligatorias no tienen valor por defecto: sin ellas la aplicacion
# (o docker compose) no arranca.

# ---------------------------------------------------------------- Base de datos (obligatorias)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=kaffehausdb
DB_USERNAME=
DB_PASSWORD=
# Espera maxima por un bloqueo de fila antes de responder 409 (lock_timeout de PostgreSQL).
DB_LOCK_TIMEOUT=5s

# ---------------------------------------------------------------- Servidor (obligatoria)
SERVER_PORT=8081

# ---------------------------------------------------------------- JWT (obligatorias)
# Secretos de al menos 32 caracteres y distintos entre si. Generalos con: openssl rand -hex 32
JWT_SECRET=
JWT_REFRESH_SECRET=
JWT_ISSUER=kaffehausv4
JWT_ACCESS_MINUTES=15
JWT_REFRESH_DAYS=7

# ---------------------------------------------------------------- CORS (obligatoria)
# Origenes del frontend separados por coma. '*' a secas no se permite.
# Ejemplo en produccion: https://app.midominio.com
CORS_ORIGENES=http://localhost:[*],http://127.0.0.1:[*]

# ---------------------------------------------------------------- Opcionales
# Client id de Google; vacio deshabilita el login con Google.
GOOGLE_CLIENT_ID=
# Solo para la primera siembra de una base nueva (POST /api/v1/seed). Despues, false y vacia.
SEED_HABILITADO=false
SEED_ADMIN_CONTRASENA=
